# ============================================
# One Stop Service — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.
# JANGAN commit file .env ke repository!

# ============================================
# Application (Backend - Laravel)
# ============================================
# Nama aplikasi, muncul di log dan notifikasi
APP_NAME="One Stop Service"

# Environment: local, staging, production
APP_ENV=local

# Laravel application key (generate: php artisan key:generate)
# WAJIB diisi, jangan kosongkan di production!
APP_KEY=

# Debug mode: true untuk development, false untuk production
APP_DEBUG=true

# Base URL aplikasi backend
APP_URL=http://localhost:8080

# Port untuk Laravel serve (local development tanpa Docker)
APP_PORT=8000

# ============================================
# Database (PostgreSQL)
# ============================================
# Driver database, WAJIB pgsql
DB_CONNECTION=pgsql

# Host database: 'postgres' jika pakai Docker, 'localhost' jika lokal
DB_HOST=postgres

# Port PostgreSQL (default: 5432)
DB_PORT=5432

# Nama database
DB_DATABASE=one_stop_service

# Username database
DB_USERNAME=postgres

# Password database (GANTI di production!)
DB_PASSWORD=secret

# ============================================
# Cache & Session
# ============================================
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ============================================
# Logging
# ============================================
# Channel: stack, single, daily, stderr
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ============================================
# Frontend (Next.js)
# ============================================
# Base URL untuk API calls dari frontend ke backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Port frontend Next.js
FRONTEND_PORT=3000

# ============================================
# Docker
# ============================================
# Port mapping untuk Nginx (akses backend API)
NGINX_PORT=8080

# Port mapping untuk PostgreSQL (akses dari host)
POSTGRES_PORT=5433

# ============================================
# Laravel Sanctum (Auth)
# ============================================
# Domain yang diizinkan untuk Sanctum SPA authentication
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Session domain
SESSION_DOMAIN=localhost
